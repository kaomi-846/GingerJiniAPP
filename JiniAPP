            "いつもいっしょにいてくれてありがとう💖"
        ];

        /* GLOBAL GAME VARIABLES */
        let gameInterval = null;
        let spawnerInterval = null;
        let timerInterval = null;
        let gameScore = 0;
        let gameTimeLeft = 15;
        let playerX = 120;
        let fallingItems = [];
        let currentGameType = 'candy';

        /* INITIALIZATION */
        window.onload = function() {
            updateClock();
            setInterval(updateClock, 1000);
            renderUI();
            renderAccessories();
            
            // Random decrease stats over time
            setInterval(() => {
                gameState.hunger = Math.max(0, gameState.hunger - 1);
                gameState.clean = Math.max(0, gameState.clean - 1);
                gameState.happy = Math.max(0, gameState.happy - 1);
                renderUI();
            }, 10000);

            // Random visitor interval
            setInterval(randomVisitorEvent, 25000);
        };

        function updateClock() {
            const now = new Date();
            const timeStr = now.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
            document.getElementById('real-time').innerText = timeStr;
        }

        function renderUI() {
            document.getElementById('coin-count').innerText = gameState.coins.toLocaleString();
            document.getElementById('shop-coin-display').innerText = gameState.coins.toLocaleString();
            
            document.getElementById('stat-hunger-num').innerText = `${gameState.hunger}%`;
            document.getElementById('stat-hunger-bar').style.width = `${gameState.hunger}%`;

            document.getElementById('stat-clean-num').innerText = `${gameState.clean}%`;
            document.getElementById('stat-clean-bar').style.width = `${gameState.clean}%`;

            document.getElementById('stat-happy-num').innerText = `${gameState.happy}%`;
            document.getElementById('stat-happy-bar').style.width = `${gameState.happy}%`;

            document.getElementById('stat-love-num').innerText = `${gameState.love}%`;
            document.getElementById('stat-love-bar').style.width = `${gameState.love}%`;

            document.getElementById('friend-level').innerText = `Lv.${gameState.level}`;
        }

        function renderAccessories() {
            const accLayer = document.getElementById('accessory-layer');
            const equipped = gameState.equippedAcc;

            if (equipped && accessoryItems[equipped]) {
                accLayer.innerHTML = accessoryItems[equipped].svg;
            } else {
                accLayer.innerHTML = '';
            }
        }

        function touchJini() {
            const wrapper = document.getElementById('jini-wrapper');
            wrapper.classList.remove('jini-idle');
            wrapper.classList.add('jini-happy-anim');

            gameState.love = Math.min(100, gameState.love + 2);
            gameState.happy = Math.min(100, gameState.happy + 2);
            renderUI();

            showParticle('💖');

            const randDialogue = dialogueList[Math.floor(Math.random() * dialogueList.length)];
            document.getElementById('speech-text').innerText = randDialogue;

            setTimeout(() => {
                wrapper.classList.remove('jini-happy-anim');
                wrapper.classList.add('jini-idle');
            }, 1600);
        }

        function showParticle(text) {
            const overlay = document.getElementById('effect-overlay');
            const particle = document.createElement('div');
            particle.className = 'absolute text-xl font-bold text-pink-500 animate-[float-up_1.2s_ease-out_forwards]';
            particle.innerText = text;
            overlay.appendChild(particle);

            setTimeout(() => particle.remove(), 1200);
        }

        function takeBath() {
            gameState.clean = 100;
            gameState.happy = Math.min(100, gameState.happy + 10);
            renderUI();

            showParticle('🧼 ぴかぴか！');
            document.getElementById('speech-text').innerText = "あわあわお風呂できれいさっぱり気持ちいい〜！✨";
            touchJini();
        }

        /* MINI GAMES IMPLEMENTATION */
        function startCandyCatchGame() {
            currentGameType = 'candy';
            document.getElementById('game-title-text').innerText = '🍬 お菓子キャッチ';
            initMiniGameScreen();
        }

        function startGingerWalkGame() {
            currentGameType = 'ginger';
            document.getElementById('game-title-text').innerText = '🌱 生姜畑のお散歩';
            initMiniGameScreen();
        }

        function initMiniGameScreen() {
            document.getElementById('game-select-view').classList.add('hidden');
            document.getElementById('mini-game-view').classList.remove('hidden');

            const canvas = document.getElementById('game-canvas');
            const ctx = canvas.getContext('2d');

            gameScore = 0;
            gameTimeLeft = 15;
            playerX = 120;
            fallingItems = [];

            document.getElementById('game-score').innerText = gameScore;
            document.getElementById('game-timer').innerText = gameTimeLeft;

            document.getElementById('btn-left').onclick = () => playerX = Math.max(20, playerX - 25);
            document.getElementById('btn-right').onclick = () => playerX = Math.min(240, playerX + 25);

            if (spawnerInterval) clearInterval(spawnerInterval);
            if (timerInterval) clearInterval(timerInterval);
            if (gameInterval) clearInterval(gameInterval);

            spawnerInterval = setInterval(() => {
                if (currentGameType === 'candy') {
                    fallingItems.push({
                        x: Math.random() * 240 + 20,
                        y: 0,
                        speed: Math.random() * 2 + 3,
                        type: Math.random() > 0.3 ? '🍬' : '🍪',
                        points: 10
                    });
                } else {
                    const r = Math.random();
                    let itemType = '🫚';
                    let pts = 10;
                    if (r < 0.25) { itemType = '💖'; pts = 15; }
                    else if (r < 0.55) { itemType = '🫚'; pts = 10; }
                    else { itemType = '🌿'; pts = -5; }

                    fallingItems.push({
                        x: Math.random() * 240 + 20,
                        y: 0,
                        speed: Math.random() * 2.5 + 3.5,
                        type: itemType,
                        points: pts
                    });
                }
            }, 500);

            timerInterval = setInterval(() => {
                gameTimeLeft--;
                document.getElementById('game-timer').innerText = gameTimeLeft;
                if (gameTimeLeft <= 0) {
                    endMiniGame();
                }
            }, 1000);

            gameInterval = setInterval(() => {
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                if (currentGameType === 'ginger') {
                    ctx.fillStyle = '#e8f5e9';
                    ctx.fillRect(0, 0, canvas.width, canvas.height);
                } else {
                    ctx.fillStyle = '#f0f9ff';
                    ctx.fillRect(0, 0, canvas.width, canvas.height);
                }

                ctx.fillStyle = currentGameType === 'ginger' ? '#81c784' : '#ffb74d';
                ctx.beginPath();
                ctx.arc(playerX, 270, 22, 0, Math.PI * 2);
                ctx.fill();
                ctx.font = '18px sans-serif';
                ctx.fillText(currentGameType === 'ginger' ? '🧺' : '🐣', playerX - 9, 276);

                for (let i = fallingItems.length - 1; i >= 0; i--) {
                    const c = fallingItems[i];
                    c.y += c.speed;
                    ctx.fillText(c.type, c.x - 8, c.y);

                    if (c.y >= 245 && c.y <= 285 && Math.abs(c.x - playerX) < 28) {
                        gameScore = Math.max(0, gameScore + c.points);
                        document.getElementById('game-score').innerText = gameScore;
                        fallingItems.splice(i, 1);
                    } else if (c.y > 300) {
                        fallingItems.splice(i, 1);
                    }
                }
            }, 1000 / 30);
        }

        function endMiniGame() {
            if (gameInterval) clearInterval(gameInterval);
            if (spawnerInterval) clearInterval(spawnerInterval);
            if (timerInterval) clearInterval(timerInterval);

            const earnedCoins = gameScore;
            gameState.coins += earnedCoins;
            gameState.happy = Math.min(100, gameState.happy + (currentGameType === 'ginger' ? 30 : 20));
            renderUI();

            const titleName = currentGameType === 'ginger' ? '生姜畑のお散歩' : 'お菓子キャッチ';
            alert(`【${titleName} 終了！】\nスコア: ${gameScore}\n🪙 ${earnedCoins} コインゲット！`);
            
            document.getElementById('mini-game-view').classList.add('hidden');
            document.getElementById('game-select-view').classList.remove('hidden');
            closeModal('play-modal');
            
            if (currentGameType === 'ginger') {
                document.getElementById('speech-text').innerText = "生姜畑でお散歩してリフレッシュしたよ！🌱";
            } else {
                document.getElementById('speech-text').innerText = "お菓子キャッチ楽しかった〜！🍬";
            }
        }

