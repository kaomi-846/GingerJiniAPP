                        <div class="text-[10px] text-gray-400 font-bold">ショップで未解放</div>
                    `}
                `;
                container.appendChild(card);
            });
        }

        function equipAccessory(key) {
            if (gameState.equippedAcc === key && key !== 'blue_ribbon') {
                gameState.equippedAcc = 'blue_ribbon';
            } else {
                gameState.equippedAcc = key;
            }
            renderAccessories();
            renderDressMenu();
        }

