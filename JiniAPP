                renderFoodMenu();

                showParticle('😋 おいしい！');
                document.getElementById('speech-text').innerText = `もぐもぐ… ${item.name}、とっても美味しい〜！`;
                touchJini();
            }
        }

        /* DRESS UP MENU */
        function renderDressMenu() {
            const container = document.getElementById('accessory-list-container');
            container.innerHTML = '';

            Object.keys(accessoryItems).forEach(key => {
                const item = accessoryItems[key];
