                        class="w-full text-xs font-black py-1 rounded-xl shadow cute-button ${count > 0 ? 'bg-amber-400 text-amber-950 hover:bg-amber-500' : 'bg-gray-200 text-gray-400 cursor-not-allowed'}">
                        あげる
                    </button>
                `;
                container.appendChild(card);
            });
        }

        function feedJini(key) {
            if (gameState.inventory[key] > 0) {
                gameState.inventory[key]--;
                const item = foodItems[key];

                gameState.hunger = Math.min(100, gameState.hunger + item.hunger);
