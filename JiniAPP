        }

        function interactVisitor() {
            gameState.coins += 50;
            gameState.happy = Math.min(100, gameState.happy + 15);
            renderUI();
            showParticle('🪙 +50');
            document.getElementById('speech-text').innerText = "お友達とおしゃべりしてプレゼントをもらったよ！";
        }

        function randomVisitorEvent() {
            if (Math.random() < 0.45) {
                const f = friendsData[Math.floor(Math.random() * friendsData.length)];
                spawnVisitor(f.name, f.avatar);
            }
        }

        /* SHOP MENU */
        let currentShopTab = 'food';
        function switchShopTab(tab) {
            currentShopTab = tab;
            document.getElementById('tab-food').className = tab === 'food' ? 'flex-1 py-1.5 font-black text-xs text-amber-950 border-b-2 border-amber-500' : 'flex-1 py-1.5 font-black text-xs text-gray-400';
            document.getElementById('tab-acc').className = tab === 'acc' ? 'flex-1 py-1.5 font-black text-xs text-amber-950 border-b-2 border-amber-500' : 'flex-1 py-1.5 font-black text-xs text-gray-400';
            renderShopMenu(tab);
        }

        function renderShopMenu(tab) {
            const container = document.getElementById('shop-items-container');
            container.innerHTML = '';

            if (tab === 'food') {
                Object.keys(foodItems).forEach(key => {
                    const item = foodItems[key];
                    const card = document.createElement('div');
                    card.className = 'bg-white border-2 border-amber-200 rounded-2xl p-2.5 shadow-sm flex items-center justify-between';
                    card.innerHTML = `
                        <div class="flex items-center space-x-3">
                            <span class="text-2xl">${item.icon}</span>
                            <div>
                                <div class="font-black text-xs text-amber-950">${item.name}</div>
                                <div class="text-[10px] text-gray-400">${item.desc}</div>
                            </div>
                        </div>
                        <button onclick="buyFood('${key}')" class="bg-yellow-400 hover:bg-yellow-500 text-amber-950 text-xs font-black px-3 py-1 rounded-xl shadow cute-button">
                            🪙 ${item.price}
                        </button>
                    `;
                    container.appendChild(card);
                });
            } else {
                Object.keys(accessoryItems).forEach(key => {
                    if (key === 'blue_ribbon') return;
                    const item = accessoryItems[key];
                    const isUnlocked = gameState.unlockedAccs.includes(key);

                    const card = document.createElement('div');
                    card.className = 'bg-white border-2 border-pink-200 rounded-2xl p-2.5 shadow-sm flex items-center justify-between';
                    card.innerHTML = `
                        <div class="flex items-center space-x-3">
                            <span class="text-2xl">${item.icon}</span>
                            <div>
                                <div class="font-black text-xs text-amber-950">${item.name}</div>
                            </div>
                        </div>
                        ${isUnlocked ? `
                            <span class="text-xs font-black text-gray-400">購入済み</span>
                        ` : `
                            <button onclick="buyAcc('${key}')" class="bg-pink-400 hover:bg-pink-500 text-white text-xs font-black px-3 py-1 rounded-xl shadow cute-button">
                                🪙 ${item.price}
                            </button>
                        `}
                    `;
                    container.appendChild(card);
                });
            }
        }

        function buyFood(key) {
            const item = foodItems[key];
            if (gameState.coins >= item.price) {
                gameState.coins -= item.price;
                gameState.inventory[key] = (gameState.inventory[key] || 0) + 1;
                renderUI();
                renderShopMenu('food');
                showParticle('🛒 購入完了!');
            } else {
                alert('コインが足りないよ！');
            }
        }

        function buyAcc(key) {
            const item = accessoryItems[key];
            if (gameState.coins >= item.price) {
                gameState.coins -= item.price;
                gameState.unlockedAccs.push(key);
                renderUI();
                renderShopMenu('acc');
                showParticle('✨ ゲット!');
            } else {
                alert('コインが足りないよ！');
            }
        }

        /* MISSION */
        function claimMission() {
            if (!gameState.missionClaimed && gameState.hunger >= 90) {
                gameState.missionClaimed = true;
                gameState.coins += 50;
                renderUI();

                const btn = document.getElementById('mission-claim-btn');
                btn.className = 'bg-gray-200 text-gray-500 font-bold px-2.5 py-1 rounded-xl cursor-not-allowed text-[10px]';
                btn.innerText = '達成済み';
                showParticle('🪙 +50');
            } else if (gameState.hunger < 90) {
                alert('おなかを90%以上にしてね！');
            }
        }
    </script>
</body>
</html>

