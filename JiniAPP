        };

        /* FRIENDS DATA */
        const friendsData = [
            { id: 'megumi', name: '芽ぐみちゃん', desc: '新芽の妖精。生姜の育ちを見守るお友達。', color: '#a5d6a7', avatar: '🌱' },
            { id: 'hana', name: 'はなちゃん', desc: 'お花が大好きでおしゃれな可愛いお友達。', color: '#f8bbd0', avatar: '🌸' },
            { id: 'honey', name: 'ハニーちゃん', desc: 'はちみつが大好きでいつも甘い香りがするよ。', color: '#ffe082', avatar: '🐝' },
            { id: 'jiiji', name: 'じいじ', desc: '親生姜のじいじ。生姜の知識がとっても豊富！', color: '#bcaaa4', avatar: '👴' },
            { id: 'baaba', name: 'ばあば', desc: '親生姜のばあば。美味しい生姜料理を作ってくれる。', color: '#d7ccc8', avatar: '👵' }
        ];

        /* DIALOGUES */
        const dialogueList = [
            "今日はいい天気だね〜！いっしょにあそぼう♪",
            "生姜クッキーを食べると、元気が湧いてくるよ！🍪",
            "芽ぐみちゃん達とお茶会したいな〜☕",
