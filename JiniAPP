<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>生姜の妖精GingerJiniちゃんはぐくみアプリ </title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Zen Maru Gothic -->
    <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700;900&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Zen Maru Gothic', sans-serif;
            background: #fdf6ec;
            touch-action: manipulation;
            user-select: none;
        }

        /* ぷっくり立体感・パステル調カスタムスタイル */
        .cute-card {
            background: #ffffff;
            border: 3px solid #ffeacc;
            box-shadow: 0 8px 20px rgba(235, 175, 110, 0.18), inset 0 -4px 0 rgba(255, 230, 190, 0.5);
            border-radius: 24px;
        }

        .cute-button {
            transition: all 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 4px 10px rgba(220, 140, 60, 0.15), inset 0 -3px 0 rgba(0,0,0,0.1);
        }
        .cute-button:active {
            transform: scale(0.93) translateY(2px);
            box-shadow: 0 2px 4px rgba(220, 140, 60, 0.1);
        }

        /* アニメーション */
        @keyframes jini-bounce {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-10px) rotate(2deg); }
        }

        @keyframes happy-dance {
            0%, 100% { transform: translateY(0) scale(1); }
            20% { transform: translateY(-18px) rotate(-6deg) scale(1.05); }
            40% { transform: translateY(0) rotate(0deg); }
            60% { transform: translateY(-18px) rotate(6deg) scale(1.05); }
            80% { transform: translateY(0) rotate(0deg); }
        }

        @keyframes float-up {
            0% { transform: translateY(0px) scale(0.8); opacity: 1; }
            100% { transform: translateY(-40px) scale(1.2); opacity: 0; }
        }

        .jini-idle {
            animation: jini-bounce 3s ease-in-out infinite;
        }

        .jini-happy-anim {
            animation: happy-dance 0.8s ease-in-out infinite;
        }

        /* 吹き出しの三角 */
        .speech-bubble {
            position: relative;
            background: #ffffff;
            border-radius: 24px;
            border: 3px solid #ffd89b;
            box-shadow: 0 6px 16px rgba(240, 170, 80, 0.15);
        }
        .speech-bubble::after {
            content: '';
            position: absolute;
            bottom: -13px;
            left: 50%;
            transform: translateX(-50%);
            border-width: 13px 11px 0;
            border-style: solid;
            border-color: #ffffff transparent;
            display: block;
            width: 0;
        }
        .speech-bubble::before {
            content: '';
            position: absolute;
            bottom: -17px;
            left: 50%;
            transform: translateX(-50%);
            border-width: 16px 13px 0;
            border-style: solid;
            border-color: #ffd89b transparent;
            display: block;
            width: 0;
        }

        /* カスタムスクロールバー */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #fff4e5; border-radius: 10px; }
        ::-webkit-scrollbar-thumb { background: #ffca85; border-radius: 10px; }
    </style>
</head>
<body class="flex justify-center items-center min-h-screen p-0 sm:p-4 bg-amber-50">

    <!-- アプリ本体（スマホ型フレーム） -->
    <div class="w-full max-w-md bg-[#fffbf5] sm:rounded-[40px] shadow-2xl border-4 border-[#ffe3bc] overflow-hidden flex flex-col min-h-[820px] max-h-[96vh] relative">
        
        <!-- HEADER STATUS BAR -->
        <header class="bg-gradient-to-b from-[#fff5e6] to-[#ffe8cc] p-3 border-b-3 border-[#ffd6a5] z-10 shadow-sm">
            <!-- Top info bar: Clock, Coins, Shop button -->
            <div class="flex justify-between items-center mb-2 text-xs font-bold text-amber-900">
                <div class="flex items-center space-x-1 bg-white/90 px-3 py-1 rounded-full shadow-sm border border-amber-200">
                    <i class="far fa-clock text-amber-500"></i>
                    <span id="real-time">9:41 AM</span>
                </div>
                
                <div class="flex items-center space-x-2">
                    <div class="flex items-center space-x-1.5 bg-amber-300 text-amber-950 px-3.5 py-1 rounded-full shadow-sm border border-amber-400 font-extrabold text-xs">
                        <span class="text-sm">🪙</span>
                        <span id="coin-count" class="text-sm">1,250</span>
                    </div>
                    <button onclick="openModal('shop-modal')" class="bg-gradient-to-r from-pink-400 to-rose-400 text-white font-bold px-3 py-1 rounded-full shadow cute-button flex items-center gap-1 text-xs">
                        <i class="fas fa-shopping-cart"></i> ショップ
                    </button>
                </div>
            </div>

            <!-- 4つのステータスメーター (おなか, きれい, ごきげん, なかよし) -->
            <div class="grid grid-cols-2 gap-2 text-[11px] font-bold">
                <!-- おなか -->
                <div class="bg-white/90 p-1.5 px-2 rounded-2xl shadow-inner border border-amber-100">
                    <div class="flex justify-between text-amber-900 mb-0.5">
                        <span class="flex items-center gap-1"><i class="fas fa-utensils text-orange-400"></i>おなか</span>
                        <span id="stat-hunger-num" class="text-orange-500">95%</span>
                    </div>
                    <div class="w-full bg-amber-100 h-2.5 rounded-full overflow-hidden p-0.5 border border-amber-200">
                        <div id="stat-hunger-bar" class="bg-gradient-to-r from-amber-400 to-orange-400 h-full rounded-full transition-all duration-500" style="width: 95%;"></div>
                    </div>
                </div>

                <!-- きれい -->
                <div class="bg-white/90 p-1.5 px-2 rounded-2xl shadow-inner border border-amber-100">
                    <div class="flex justify-between text-sky-900 mb-0.5">
                        <span class="flex items-center gap-1"><i class="fas fa-tint text-sky-400"></i>きれい</span>
                        <span id="stat-clean-num" class="text-sky-500">88%</span>
                    </div>
                    <div class="w-full bg-sky-100 h-2.5 rounded-full overflow-hidden p-0.5 border border-sky-200">
                        <div id="stat-clean-bar" class="bg-gradient-to-r from-sky-300 to-sky-400 h-full rounded-full transition-all duration-500" style="width: 88%;"></div>
                    </div>
                </div>

                <!-- ごきげん -->
                <div class="bg-white/90 p-1.5 px-2 rounded-2xl shadow-inner border border-amber-100">
                    <div class="flex justify-between text-emerald-900 mb-0.5">
                        <span class="flex items-center gap-1"><i class="fas fa-smile text-emerald-400"></i>ごきげん</span>
                        <span id="stat-happy-num" class="text-emerald-500">92%</span>
                    </div>
                    <div class="w-full bg-emerald-100 h-2.5 rounded-full overflow-hidden p-0.5 border border-emerald-200">
                        <div id="stat-happy-bar" class="bg-gradient-to-r from-emerald-300 to-green-400 h-full rounded-full transition-all duration-500" style="width: 92%;"></div>
                    </div>
                </div>

                <!-- なかよし -->
                <div class="bg-white/90 p-1.5 px-2 rounded-2xl shadow-inner border border-amber-100">
                    <div class="flex justify-between text-pink-900 mb-0.5">
                        <span class="flex items-center gap-1"><i class="fas fa-heart text-pink-400"></i>なかよし</span>
                        <span id="stat-love-num" class="text-pink-500">87%</span>
                    </div>
                    <div class="w-full bg-pink-100 h-2.5 rounded-full overflow-hidden p-0.5 border border-pink-200">
                        <div id="stat-love-bar" class="bg-gradient-to-r from-pink-300 to-rose-400 h-full rounded-full transition-all duration-500" style="width: 87%;"></div>
                    </div>
                </div>
            </div>
        </header>

        <!-- MAIN ROOM AREA -->
        <main class="flex-1 relative flex flex-col justify-between p-3 overflow-hidden bg-gradient-to-b from-[#fffef0] via-[#fff8e7] to-[#ffeed5]">
            
            <!-- Room Background Elements -->
            <div class="absolute top-2 left-4 w-24 h-24 bg-sky-200/50 rounded-full border-4 border-white/80 overflow-hidden shadow-inner flex items-center justify-center -z-0">
                <div class="w-full h-full bg-gradient-to-b from-sky-200 to-amber-100 relative">
                    <div class="absolute top-2 left-2 text-yellow-300 text-lg opacity-80">☀️</div>
                    <div class="absolute bottom-1 right-2 text-white text-xs font-bold opacity-70">☁️</div>
                </div>
            </div>

            <div class="absolute top-16 left-3 text-2xl text-emerald-400/80 -z-0"><i class="fas fa-leaf"></i></div>

            <div class="absolute top-12 right-2 flex flex-col items-end opacity-90 -z-0">
                <div class="w-10 h-10 bg-amber-100 border-2 border-amber-300 rounded-lg p-1 shadow-sm mb-2 flex items-center justify-center">
                    <span class="text-xs">🐣</span>
                </div>
                <div class="w-28 h-16 bg-amber-200/60 rounded-3xl border-2 border-amber-300/60 shadow-inner flex items-center justify-center relative">
                    <div class="absolute -left-4 -bottom-1 bg-pink-300 border-2 border-pink-400 rounded-full px-2 py-0.5 text-[10px] font-black text-white shadow-md transform -rotate-12">
                        🍬 Jin
                    </div>
                </div>
            </div>

            <!-- Speech Bubble -->
            <div class="w-full z-10 my-1 px-2">
                <div class="speech-bubble p-2.5 text-center text-amber-950 font-bold text-xs sm:text-sm flex items-center justify-center gap-2">
                    <span id="speech-icon" class="text-base">🎵</span>
                    <span id="speech-text">今日はいい天気だね〜！いっしょにあそぼう♪</span>
                </div>
            </div>

            <!-- Jini-chan Stage -->
            <div class="relative w-full flex-1 flex flex-col items-center justify-center my-1">
                <div class="absolute bottom-2 w-72 h-28 bg-emerald-100/80 rounded-[100%] border-4 border-emerald-200/90 shadow-inner -z-0 flex items-center justify-center">
                    <div class="text-emerald-300/40 text-xs font-bold space-x-4">
                        <span>🌸</span><span>🌼</span><span>🌸</span>
                    </div>
                </div>

                <!-- Visitor Spot -->
                <div id="visitor-container" class="absolute left-3 bottom-6 transition-all duration-500 transform translate-y-12 opacity-0 z-10 flex flex-col items-center cursor-pointer" onclick="interactVisitor()">
                    <div id="visitor-bubble" class="bg-white px-2 py-1 rounded-xl text-[10px] font-bold text-amber-900 shadow border-2 border-amber-300 mb-1 animate-pulse">あそびにきたよ！</div>
                    <div id="visitor-character" class="w-16 h-16 flex items-center justify-center text-4xl filter drop-shadow-md"></div>
                </div>

                <!-- JINI-CHAN CHARACTER -->
                <div id="jini-wrapper" class="relative z-20 cursor-pointer jini-idle transition-transform duration-300" onclick="touchJini()">
                    <div id="effect-overlay" class="absolute inset-0 pointer-events-none z-30 flex justify-center items-center"></div>

                    <svg id="jini-svg" width="220" height="220" viewBox="0 0 200 200" class="filter drop-shadow-md">
                        <defs>
                            <linearGradient id="jiniBodyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                                <stop offset="0%" stop-color="#fff176" />
                                <stop offset="100%" stop-color="#fbc02d" />
                            </linearGradient>

                            <pattern id="gingerPattern" width="12" height="12" patternUnits="userSpaceOnUse" patternTransform="rotate(30)">
                                <line x1="0" y1="0" x2="0" y2="12" stroke="#e65100" stroke-width="2.5" opacity="0.35"/>
                            </pattern>

                            <pattern id="ginghamCheck" width="10" height="10" patternUnits="userSpaceOnUse">
                                <rect width="10" height="10" fill="#b3e5fc"/>
                                <rect width="5" height="10" fill="#4fc3f7" opacity="0.5"/>
                                <rect width="10" height="5" fill="#4fc3f7" opacity="0.5"/>
                            </pattern>
                        </defs>

                        <!-- LEGS & SHOES -->
                        <g id="jini-feet">
                            <ellipse cx="74" cy="172" rx="14" ry="10" fill="#ffffff" stroke="#212121" stroke-width="3.5"/>
                            <line x1="77" y1="152" x2="74" y2="162" stroke="#212121" stroke-width="4" stroke-linecap="round"/>
                            <ellipse cx="126" cy="172" rx="14" ry="10" fill="#ffffff" stroke="#212121" stroke-width="3.5"/>
                            <line x1="123" y1="152" x2="126" y2="162" stroke="#212121" stroke-width="4" stroke-linecap="round"/>
                        </g>

                        <!-- GINGER BUNS -->
                        <g id="bun-left">
                            <circle cx="48" cy="62" r="27" fill="url(#jiniBodyGrad)" stroke="#212121" stroke-width="4"/>
                            <circle cx="48" cy="62" r="27" fill="url(#gingerPattern)"/>
                        </g>
                        <g id="bun-right">
                            <circle cx="152" cy="62" r="27" fill="url(#jiniBodyGrad)" stroke="#212121" stroke-width="4"/>
                            <circle cx="152" cy="62" r="27" fill="url(#gingerPattern)"/>
                        </g>

                        <!-- BODY -->
                        <circle cx="100" cy="105" r="55" fill="url(#jiniBodyGrad)" stroke="#212121" stroke-width="4.5"/>

                        <!-- HANDS -->
                        <g id="jini-hands">
                            <path d="M 50 115 Q 35 110 35 120" fill="none" stroke="#212121" stroke-width="4" stroke-linecap="round"/>
                            <circle cx="33" cy="122" r="10" fill="#ffffff" stroke="#212121" stroke-width="3.5"/>
                            <path d="M 150 115 Q 165 110 165 120" fill="none" stroke="#212121" stroke-width="4" stroke-linecap="round"/>
                            <circle cx="167" cy="122" r="10" fill="#ffffff" stroke="#212121" stroke-width="3.5"/>
                        </g>

                        <!-- FACE -->
                        <g id="jini-face">
                            <path id="eye-left" d="M 74 95 Q 83 83 92 95" fill="none" stroke="#212121" stroke-width="5" stroke-linecap="round"/>
                            <path id="eye-right" d="M 108 95 Q 117 83 126 95" fill="none" stroke="#212121" stroke-width="5" stroke-linecap="round"/>
                            <ellipse cx="70" cy="107" rx="10" ry="7" fill="#ff7043" opacity="0.75"/>
                            <ellipse cx="130" cy="107" rx="10" ry="7" fill="#ff7043" opacity="0.75"/>
                            <path id="mouth" d="M 86 112 Q 100 130 114 112 Z" fill="#e53935" stroke="#212121" stroke-width="3.5" stroke-linejoin="round"/>
                        </g>

                        <!-- BLUE RIBBON -->
                        <g id="blue-check-ribbon" transform="translate(136, 68) rotate(-12)">
                            <path d="M -4 0 C -22 -18 -32 8 -4 5 Z" fill="url(#ginghamCheck)" stroke="#0277bd" stroke-width="3"/>
                            <path d="M 4 0 C 22 -18 32 8 4 5 Z" fill="url(#ginghamCheck)" stroke="#0277bd" stroke-width="3"/>
                            <path d="M -2 4 L -10 20 L -2 15 Z" fill="url(#ginghamCheck)" stroke="#0277bd" stroke-width="2"/>
                            <path d="M 2 4 L 10 20 L 2 15 Z" fill="url(#ginghamCheck)" stroke="#0277bd" stroke-width="2"/>
                            <circle cx="0" cy="2" r="8.5" fill="#ffd54f" stroke="#212121" stroke-width="2.5"/>
                            <circle cx="-3" cy="0" r="1.2" fill="#212121"/>
                            <circle cx="3" cy="0" r="1.2" fill="#212121"/>
                            <path d="M -3 3 Q 0 6 3 3" fill="none" stroke="#212121" stroke-width="1.5" stroke-linecap="round"/>
                        </g>

                        <!-- DYNAMIC ACCESSORY LAYER -->
                        <g id="accessory-layer"></g>
                    </svg>
                </div>

                <!-- Level Badge -->
                <div class="absolute right-2 bottom-4 bg-white/95 border-3 border-pink-200 rounded-2xl p-2 shadow-md text-center flex flex-col items-center">
                    <div class="text-[10px] font-black text-pink-500 flex items-center gap-1">
                        <i class="fas fa-heart"></i> なかよし度
                    </div>
                    <div id="friend-level" class="text-base font-black text-amber-950">Lv.5</div>
                    <div class="text-[9px] text-gray-500 font-bold" id="next-level-exp">あと 50 ⭐</div>
                </div>
            </div>

            <!-- ACTION BUTTONS GRID -->
            <div class="grid grid-cols-3 gap-2.5 z-10 mt-1">
                <button onclick="openModal('food-modal')" class="cute-card p-2 rounded-2xl flex flex-col items-center justify-center cute-button bg-gradient-to-b from-amber-50 to-orange-100 border-amber-200">
                    <div class="w-10 h-10 rounded-full bg-orange-400 text-white flex items-center justify-center text-xl shadow-md mb-1">🍪</div>
                    <span class="text-xs font-black text-amber-950">ごはん</span>
                </button>
                <button onclick="takeBath()" class="cute-card p-2 rounded-2xl flex flex-col items-center justify-center cute-button bg-gradient-to-b from-sky-50 to-blue-100 border-sky-200">
                    <div class="w-10 h-10 rounded-full bg-sky-400 text-white flex items-center justify-center text-xl shadow-md mb-1">🛁</div>
                    <span class="text-xs font-black text-sky-950">おふろ</span>
                </button>
                <button onclick="openModal('play-modal')" class="cute-card p-2 rounded-2xl flex flex-col items-center justify-center cute-button bg-gradient-to-b from-emerald-50 to-green-100 border-emerald-200">
                    <div class="w-10 h-10 rounded-full bg-emerald-400 text-white flex items-center justify-center text-xl shadow-md mb-1">🎮</div>
                    <span class="text-xs font-black text-emerald-950">あそぶ</span>
                </button>
                <button onclick="openModal('dress-modal')" class="cute-card p-2 rounded-2xl flex flex-col items-center justify-center cute-button bg-gradient-to-b from-pink-50 to-rose-100 border-pink-200">
                    <div class="w-10 h-10 rounded-full bg-pink-400 text-white flex items-center justify-center text-xl shadow-md mb-1">🎀</div>
                    <span class="text-xs font-black text-pink-950">きせかえ</span>
                </button>
                <button onclick="openModal('zukan-modal')" class="cute-card p-2 rounded-2xl flex flex-col items-center justify-center cute-button bg-gradient-to-b from-amber-50 to-yellow-100 border-amber-200">
                    <div class="w-10 h-10 rounded-full bg-amber-400 text-white flex items-center justify-center text-xl shadow-md mb-1">📖</div>
                    <span class="text-xs font-black text-amber-950">ずかん</span>
                </button>
                <button onclick="openModal('shop-modal')" class="cute-card p-2 rounded-2xl flex flex-col items-center justify-center cute-button bg-gradient-to-b from-yellow-50 to-amber-100 border-yellow-200">
                    <div class="w-10 h-10 rounded-full bg-yellow-400 text-amber-950 flex items-center justify-center text-xl shadow-md mb-1">🏪</div>
                    <span class="text-xs font-black text-amber-950">ショップ</span>
                </button>
            </div>

            <!-- LOWER MISSION & EVENT BANNER -->
            <div class="grid grid-cols-5 gap-2 mt-2.5 z-10">
                <div class="col-span-3 bg-white/95 border-2 border-amber-200 rounded-2xl p-2 shadow-sm flex items-center justify-between text-xs">
                    <div class="flex items-center space-x-2">
                        <span class="text-lg">🚩</span>
                        <div>
                            <div class="font-black text-amber-950 text-[11px]">今日のミッション</div>
                            <div class="text-[10px] text-amber-700" id="mission-desc">おなかを 90% 以上にしよう！</div>
                        </div>
                    </div>
                    <button id="mission-claim-btn" onclick="claimMission()" class="bg-yellow-400 hover:bg-yellow-500 text-amber-950 font-black px-2.5 py-1 rounded-xl shadow text-[10px] cute-button">
                        🪙 50
                    </button>
                </div>
                <div class="col-span-2 bg-gradient-to-r from-pink-300 to-purple-300 border-2 border-pink-400 rounded-2xl p-1.5 shadow-sm flex items-center justify-between text-white text-[10px] font-bold">
                    <div>
                        <div class="text-yellow-200 font-black">⭐ イベント中！</div>
                        <div class="text-[9px]">ハッピーキャンディフェス</div>
                    </div>
                    <span class="text-xs">✨</span>
                </div>
            </div>
        </main>

        <!-- FOOTER -->
        <footer class="bg-[#fff4e5] py-2 text-center border-t-2 border-[#ffe0b2]">
            <span class="text-xs font-black text-amber-900 flex items-center justify-center gap-1.5">
                <i class="fas fa-heart text-pink-400"></i> Jiniちゃんと たのしい毎日を♪ <i class="fas fa-sparkles text-amber-500"></i>
            </span>
        </footer>
    </div>


    <!-- ==================== MODALS ==================== -->

    <!-- 1. FOOD MODAL -->
    <div id="food-modal" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 flex justify-center items-center hidden p-4">
        <div class="bg-[#fffcf7] rounded-3xl p-5 w-full max-w-sm border-4 border-amber-300 shadow-2xl relative">
            <button onclick="closeModal('food-modal')" class="absolute top-3 right-3 bg-rose-400 text-white w-8 h-8 rounded-full font-bold shadow hover:bg-rose-500">✕</button>
            <div class="flex items-center space-x-2 mb-3">
                <div class="w-8 h-8 rounded-full bg-amber-400 text-white flex items-center justify-center text-lg shadow">🍪</div>
                <h3 class="font-black text-amber-950 text-base">生姜のごはんメニュー</h3>
            </div>
            <div class="grid grid-cols-2 gap-2.5 max-h-80 overflow-y-auto p-1" id="food-list-container"></div>
        </div>
    </div>

    <!-- 2. MINI-GAMES MODAL -->
    <div id="play-modal" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 flex justify-center items-center hidden p-4">
        <div class="bg-[#fffcf7] rounded-3xl p-5 w-full max-w-sm border-4 border-emerald-300 shadow-2xl relative">
            <button onclick="closeModal('play-modal')" class="absolute top-3 right-3 bg-rose-400 text-white w-8 h-8 rounded-full font-bold shadow hover:bg-rose-500">✕</button>
            
            <div id="game-select-view">
                <h3 class="font-black text-emerald-950 text-base mb-4 text-center">あそびをえらんでね</h3>
                <div class="space-y-3">
                    <button onclick="startCandyCatchGame()" class="w-full bg-gradient-to-r from-pink-400 to-rose-400 text-white p-3.5 rounded-2xl shadow-md text-left font-bold cute-button flex justify-between items-center">
                        <div>
                            <div class="text-sm font-black">🍬 お菓子キャッチ</div>
                            <div class="text-[11px] opacity-90">降ってくるキャンディを拾おう！</div>
                        </div>
                        <i class="fas fa-play text-xs"></i>
                    </button>

                    <button onclick="startGingerWalkGame()" class="w-full bg-gradient-to-r from-emerald-400 to-green-500 text-white p-3.5 rounded-2xl shadow-md text-left font-bold cute-button flex justify-between items-center">
                        <div>
                            <div class="text-sm font-black">🌱 生姜畑のリフレッシュお散歩</div>
                            <div class="text-[11px] opacity-90">立派な生姜を収穫してリフレッシュ！</div>
                        </div>
                        <i class="fas fa-play text-xs"></i>
                    </button>
                </div>
            </div>

            <div id="mini-game-view" class="hidden flex flex-col items-center">
                <div class="flex justify-between w-full font-black text-xs text-amber-950 mb-2">
